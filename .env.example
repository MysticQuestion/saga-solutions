# Public deployment URL, without trailing slash
PUBLIC_SITE_URL=https://sagasystems.net

# Stripe
# Keep secrets server-side. Fixed live Price IDs have safe server-side fallbacks in api/create-checkout.js;
# these variables can override them per environment when needed.
STRIPE_SECRET_KEY=sk_test_or_live
STRIPE_PRICE_DIAGNOSTIC=price_1U5tfw0TbfgV8jIjuTLRQIKX
STRIPE_PRICE_BLUEPRINT=price_1U5tg80TbfgV8jIj0bGH5dyN
STRIPE_PRICE_PROTOTYPE=price_1U5tgF0TbfgV8jIjhtAhy7cr

# Supabase server-side values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase public client. Use a publishable key only.
# Never place a service-role or secret key in a VITE_* variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Transactional email
RESEND_API_KEY=re_xxx
SAGA_FROM_EMAIL=Saga Systems <projects@sagasystems.net>
PROJECT_OPERATIONS_EMAIL=info@sagasystems.net
PUBLIC_CONTACT_EMAIL=info@sagasystems.net

# Optional AI-backed internal systems. Public rendering does not require these.
OPENAI_API_KEY=
SAGA_EDITORIAL_TOKEN=
OPENAI_EDITORIAL_MODEL=
