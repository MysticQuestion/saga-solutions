# Public deployment URL, without trailing slash
PUBLIC_SITE_URL=https://your-domain.example

# Stripe
STRIPE_SECRET_KEY=sk_test_or_live
STRIPE_PRICE_DIAGNOSTIC=price_xxx
STRIPE_PRICE_BLUEPRINT=price_xxx
STRIPE_PRICE_PROTOTYPE=price_xxx
STRIPE_PRICE_PARTNER=price_xxx

# Supabase server-side values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase public read client for SAGA BLOG + SAGA CODE
# Use a publishable key only. Never place a service-role or secret key in a VITE_* variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Transactional email
RESEND_API_KEY=re_xxx
SAGA_FROM_EMAIL=Saga Solutions <projects@your-verified-domain.example>
PROJECT_COORDINATOR_EMAIL=ericmichael.wil@gmail.com

# Optional future editorial assistant. Public rendering does not require this.
OPENAI_API_KEY=
SAGA_EDITORIAL_TOKEN=
OPENAI_EDITORIAL_MODEL=gpt-5.6-terra
