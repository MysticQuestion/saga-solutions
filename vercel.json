{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/checkout", "destination": "/checkout/index.html" },
    { "source": "/checkout/", "destination": "/checkout/index.html" },
    { "source": "/work", "destination": "/" },
    { "source": "/work/", "destination": "/" },
    { "source": "/work/:slug", "destination": "/" },
    { "source": "/blog", "destination": "/" },
    { "source": "/blog/:slug", "destination": "/" },
    { "source": "/tech", "destination": "/tech/index.html" },
    { "source": "/tech/", "destination": "/tech/index.html" },
    { "source": "/tech/:slug", "destination": "/tech/index.html" },
    { "source": "/vibes", "destination": "/" },
    { "source": "/code", "destination": "/" },
    { "source": "/code/:slug", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
